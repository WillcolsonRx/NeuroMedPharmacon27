# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
ADMIN_TOKEN="change-me"

# Gmail SMTP Email Server Configuration
# Senders and receivers use the conference Gmail account with App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="conference.secretariat@gmail.com"
SMTP_PASS="your-16-char-app-password"
ORGANIZER_EMAIL="conference.secretariat@gmail.com"

# Permanent production storage. Server-only; never expose the service role key.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
